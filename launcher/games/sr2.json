{ "id": "sr2", "name": "Saints Row 2", "steamAppId": 9480, "exe": "SR2_pc.exe",
  "maxPlayers": 4, "port": 27962, "sessionKind": "rendezvous", "supportedBuilds": [1076239], "bootKeys": ["max_players", "transport"],
  "requires": [ { "file": "DFEngine.dll", "name": "Juiced" } ],
  "adapterFiles": [ { "src": "adapters/sr2/dinput8.dll", "dst": "dinput8.dll" },
                    { "src": "adapters/sr2/scripts.delta.json", "dst": "coop/scripts", "generate": "delta" } ],
  "adapterIni": "coop/sr2_adapter.ini",
  "adapterLog": "coop/sr2_adapter.log",
  "crashFiles": ["Juiced/CrashDumps/*.log", "Juiced/CrashDumps/*.dmp", "coop/dumps/*.dmp", "coop/dumps/*.txt"],
  "frameworkLog": "debug.txt",
  "saveBackup": { "dir": "{localappdata}/THQ/Saints Row 2", "into": "coop/save_backups", "keep": 10 },
  "joinFile": "coop/sr2_join.txt",
  "statusFile": "coop/sr2_status.txt",
  "bridgeWhen": { "key": "transport", "value": "steam" },
  "options": [
    { "key": "transport", "label": "Network", "host": true, "values": [
      { "value": "steam", "label": "Steam" }, { "value": "native", "label": "Direct" } ] },
    { "key": "max_players", "label": "Players", "host": true, "values": [
      { "value": "4", "label": "4" }, { "value": "3", "label": "3" }, { "value": "2", "label": "2" } ] },
    { "key": "trace", "label": "Trace", "settings": true, "values": [
      { "value": "1", "label": "On" }, { "value": "0", "label": "Off" } ] }
  ] }
